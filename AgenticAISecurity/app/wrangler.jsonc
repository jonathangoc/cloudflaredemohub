{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "seven-hills-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  // Attendees add the custom domain and variables in the dashboard. With no
  // routes here and keep_vars set, a redeploy does not remove them.
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  // MCP_CLIENT_SECRET is a Worker secret; set it with `wrangler secret put`, never here.
  "vars": {
    "MCP_CLIENT_ID": "7786ede5a0c3a9c04f152fd7fb9ab468.access",
    "MCP_SERVER_URL": "https://mcp.seven-hills-agent.jonathangoc.com/mcp"
  }
}
