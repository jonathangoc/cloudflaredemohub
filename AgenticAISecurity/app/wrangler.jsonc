{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "seven-hills-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  // Attendees add the custom domain and variables in the dashboard. With no
  // routes here and keep_vars set, a redeploy does not remove them.
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  }
}
