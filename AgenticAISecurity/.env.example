# Copy to .env (never commit .env) or export these in your shell.
# scripts/deploy.sh prompts for any missing account ID.

# Account that runs the Seven Hills app Worker. Attendees work in this account.
LAB_ACCOUNT_ID=

# Account that runs the lab guide and Shared Operations MCP server.
# Leave empty to use the lab account (single-account setup).
SERVICES_ACCOUNT_ID=

# Optional. If unset, Wrangler uses CLOUDFLARE_API_TOKEN or your `wrangler login` session.
# Use per-account tokens if one identity cannot see both accounts.
# LAB_API_TOKEN=
# SERVICES_API_TOKEN=

# Optional. Public guide URL if you serve the guide from a custom domain.
# GUIDE_URL=https://lab-guide.example.com
